### 1. Admin login
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "Login": "TestAdmin",
  "Password": "IntegrationTest123"
}

### 2. File Input (Admin Only)
POST {{HostAddress}}/api/imports
Authorization: Bearer {{AdminToken}}
Content-Type: multipart/form-data; boundary=boundary_string

--boundary_string
Content-Disposition: form-data; name="File"; filename="DO KONWERTERA - NOWO.xlsx"
Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

< ./DO\ KONWERTERA\ -\ NOWO.xlsx
--boundary_string
Content-Disposition: form-data; name="Voivodeship"

Małopolskie
--boundary_string
Content-Disposition: form-data; name="Year"

2023
--boundary_string
Content-Disposition: form-data; name="Period"

1
--boundary_string
Content-Disposition: form-data; name="DataType"

2
--boundary_string--

### 3. Import List Download (Admin Only)
GET {{HostAddress}}/api/imports
Authorization: Bearer {{AdminToken}}
Accept: application/json

### 4. Import Details Download (Admin Only)
GET {{HostAddress}}/api/imports/{{ImportId}}
Authorization: Bearer {{AdminToken}}
Accept: application/json

### 5. Download Records for selected import
GET {{HostAddress}}/api/imports/{{ImportId}}/records
Authorization: Bearer {{AdminToken}}
Accept: application/json